# ============ 数据库配置（docker-compose 中 db 服务使用） ============
# 生产环境请改为强密码，切勿使用示例值
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=blog_db
MYSQL_USER=bloguser
MYSQL_PASSWORD=change-me-user

# ============ 后端配置 ============
ENVIRONMENT=production
# Docker 网络内后端连接数据库的主机名是 db；本地直连 MySQL 时改成 127.0.0.1
DATABASE_URL=mysql+pymysql://bloguser:change-me-user@db:3306/blog_db?charset=utf8mb4

# TiDB Cloud Starter 公网连接示例（主机、用户名、密码和库名换成控制台显示的值）：
# 用户名必须带实例前缀，例如 3pTAoNNegb47Uc8.root；密码中的 @ : / ? # 等字符要做 URL 编码。
# Render 的 Python 运行时使用 Debian CA 路径；Windows 本地测试可改为 ISRG Root X1 PEM 的绝对路径。
# DATABASE_URL=mysql+pymysql://<prefix>.root:<url-encoded-password>@<host>:4000/blog_db?charset=utf8mb4&ssl_ca=/etc/ssl/certs/ca-certificates.crt&ssl_verify_cert=true&ssl_verify_identity=true

# JWT 签名密钥，请替换为随机长字符串（例如 python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=change-me-to-a-random-secret

# 管理员账号：仅用于初始化/种子脚本，普通注册用户无法获得管理员角色
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# 允许跨域的前端地址，多个地址用英文逗号分隔；同源反代部署时可不改
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# GitHub Pages 只写 Origin，不包含仓库子路径：
# CORS_ORIGINS=https://<你的GitHub用户名>.github.io

# Render 免费实例无法执行一次性 shell 命令；设为 1 时后端启动会自动执行幂等 seed
SEED_ON_STARTUP=0

# 数据库连接池；TiDB Cloud Starter 会回收长时间空闲的连接
DB_POOL_RECYCLE=240
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# 仅在 ENABLE_IMAGE_UPLOAD=true 时用于生成上传文件 URL。
# Render 的本地磁盘不是持久化存储：重启、重新部署或休眠后文件可能丢失。
PUBLIC_BASE_URL=

# 演示部署保持 false：封面、头像和正文展示图放在 frontend/public/images。
# 仅在本机/Docker 且上传目录有持久卷时才考虑开启。
ENABLE_IMAGE_UPLOAD=false

# 以下变量只用于前端构建，不会从 Render 后端读取。
# GitHub Pages 项目站点示例：/my-blog/；用户站点或自定义域名：/
VITE_BASE_PATH=/
VITE_API_BASE_URL=
VITE_IMAGE_UPLOAD_ENABLED=false
# 仅用于临时查看尚未迁移的 /uploads 旧文件，不视为持久化：
VITE_LEGACY_UPLOAD_BASE_URL=

# 前端容器对外端口；云服务器上可直接设置为 80
PUBLIC_PORT=8080
